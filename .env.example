# --- Multi-provider router (recommended) ---
# With GROQ_API_KEY and/or GEMINI_API_KEY set, Scout routes each call through the candidate list
# in scout/config.py (ROUTES) and fails over on quota, long rate limits, 401 or 403.
GROQ_API_KEY=
GEMINI_API_KEY=
# auto (default): route when a provider key above is set; on: always route; off: use LLM_* only.
SCOUT_LLM_ROUTER=auto

# --- Single provider (fallback when no router key is set) ---
# Any OpenAI-compatible endpoint (Groq, Gemini OpenAI-compat, OpenRouter, local Ollama).
# Example (Groq): https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=
# Planner, synthesizer, reflector.
SCOUT_MODEL=
# Optional: executor and critic. Falls back to SCOUT_MODEL when empty.
SCOUT_FAST_MODEL=

# Optional: when empty, web search uses DuckDuckGo (ddgs) only.
TAVILY_API_KEY=
